<%- include("./partials/head.ejs") %>
<link rel="stylesheet" href="/css/choose.css">
<script src="/script/fetch_vote.js" defer></script>
<%- include("./partials/header.ejs") %>
   
<!--Revene man stemmer på vises i main-->
<main>
    <% foxes.forEach(fox => {%>
        <section>
            <img src="<%= fox.img %>" alt="Bilde av en søt rev med masse andre rever eller en rev som er alene">
            <h2><%= fox.name %></h2>
            <button class="vote" data-id="<%=fox._id  %>">Stem</button>
        </section>
  <%  }); %>
</main>


</body>
</html>