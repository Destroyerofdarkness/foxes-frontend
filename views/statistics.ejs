<%- include("./partials/head.ejs") %>
<link rel="stylesheet" href="/css/statistics.css">
<%- include("./partials/header.ejs") %>

<!--Alle revene vises her i stemmerekkefølgen -->
<main>
    <%for(let i = 0;i<foxes.length;i++){%>
        <% if(i === 0){ %>
            <h2>Rev <%= foxes[i].name  %> er søtest!!</h2>
        <% } %>
        <section>
        <img src="<%= foxes[i].img  %>" alt="Bilde av en søt rev med masse andre rever eller en rev som er alene">
        <h3><%= foxes[i].name %></h3>
        <p>Stemmer: <%= foxes[i].votes %></p>
        </section>
    <%} %>
</main>

</body>
</html>